{
  "name": "horat1us/yii2-environment-config",
  "description": "Yii2 environment-config integration",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "yiisoft/yii2": "^2.0.53",
    "horat1us/environment-config": "^1.6",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "horat1us/yii2-asset-free": "^1.0.1",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Horat1us\\Environment\\Yii2\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Horat1us\\Environment\\Yii2\\Tests\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Alexander Letnikow",
      "email": "reclamme@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "scripts": {
    "lint": "./vendor/bin/phpcs --standard=PSR2 ./src ./tests",
    "phpcbf": "./vendor/bin/phpcbf --standard=PSR2 ./src ./tests",
    "test": "./vendor/bin/phpunit",
    "cover-xml": "./vendor/bin/phpunit --coverage-clover=coverage.xml"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
